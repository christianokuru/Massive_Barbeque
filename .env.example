# ==============================================
# MASSIVE BARBEQUE - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# ==============================================

# ==============================================
# SUPABASE
# ==============================================
# Project Settings → API in your Supabase dashboard.
SUPABASE_URL=
SUPABASE_KEY=
# service_role key — server only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Admin bootstrap: comma-separated emails given the admin role on
# sign-up/sign-in. Set this BEFORE creating the first admin account.
ADMIN_EMAILS=

# ==============================================
# EMAIL SERVICE (Resend)
# ==============================================
# Get API key from https://resend.com
RESEND_API_KEY=
FROM_EMAIL=orders@massivebarbeque.com
FROM_NAME=Massive Barbeque
CONTACT_RECEIVER_EMAIL=info@massivebarbeque.com

# ==============================================
# PAYMENT GATEWAYS
# ==============================================
# Paystack (https://paystack.com)
PAYSTACK_SECRET_KEY=
NUXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Flutterwave (https://flutterwave.com)
FLUTTERWAVE_SECRET_KEY=
NUXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# ==============================================
# GOOGLE ANALYTICS 4
# ==============================================
# Get your Measurement ID from Google Analytics
# Visit: https://analytics.google.com
# Format: G-XXXXXXXXXX
NUXT_PUBLIC_GA_ID=

# ==============================================
# APP CONFIGURATION
# ==============================================
NUXT_PUBLIC_APP_NAME=Massive Barbeque
NUXT_PUBLIC_APP_URL=https://massivebarbeque.com
NUXT_PUBLIC_APP_DESCRIPTION=Premium BBQ Catering in Lagos - Catfish, Chicken, Turkey, Croaker & More

# ==============================================
# NOTES
# ==============================================
# 1. Create a Supabase project and fill in SUPABASE_* above
# 2. Get payment gateway keys from respective dashboards
# 3. Keep this file updated as you add new environment variables
# ==============================================
# MASSIVE BARBEQUE - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# ==============================================

# ==============================================
# DATABASE (PostgreSQL)
# ==============================================
# Get connection string from your PostgreSQL provider
# Example: postgresql://user:password@host:port/database
# Neon: use the POOLED (-pooler) host for runtime queries...
DATABASE_URL=
# ...and the DIRECT (non-pooler) host ONLY for drizzle-kit migrations.
# With Neon this is the same URL minus "-pooler" from the hostname.
# Falls back to DATABASE_URL if left empty.
DIRECT_URL=

# ==============================================
# BETTER AUTH
# ==============================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Your app's base URL (e.g., http://localhost:3000 or https://yourdomain.com)
BETTER_AUTH_URL=http://localhost:3000

# ==============================================
# EMAIL SERVICE (Resend)
# ==============================================
# Get API key from https://resend.com
RESEND_API_KEY=
FROM_EMAIL=orders@massivebarbeque.com
FROM_NAME=Massive Barbeque
CONTACT_RECEIVER_EMAIL=info@massivebarbeque.com

# ==============================================
# PAYMENT GATEWAYS
# ==============================================
# Paystack (https://paystack.com)
PAYSTACK_SECRET_KEY=
NUXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Flutterwave (https://flutterwave.com)
FLUTTERWAVE_SECRET_KEY=
NUXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# ==============================================
# GOOGLE ANALYTICS 4
# ==============================================
# Get your Measurement ID from Google Analytics
# Visit: https://analytics.google.com
# Format: G-XXXXXXXXXX
NUXT_PUBLIC_GA_ID=

# ==============================================
# APP CONFIGURATION
# ==============================================
NUXT_PUBLIC_APP_NAME=Massive Barbeque
NUXT_PUBLIC_APP_URL=https://massivebarbeque.com
NUXT_PUBLIC_APP_DESCRIPTION=Premium BBQ Catering in Lagos - Catfish, Chicken, Turkey, Croaker & More

# ==============================================
# NOTES
# ==============================================
# 1. Set up PostgreSQL database first
# 2. Generate BETTER_AUTH_SECRET with openssl
# 3. Get payment gateway keys from respective dashboards
# 4. Update BETTER_AUTH_URL for production domain
# 5. Keep this file updated as you add new environment variables